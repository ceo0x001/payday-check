# Supabase — create a project at https://supabase.com, then run
#   supabase/migrations/0001_init.sql
# in the SQL editor.
#
# The browser never talks to Supabase directly. The service-role key is used
# only in server-side route handlers and must never be exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt for the one-way hashes used in rate limiting and device classification.
# We never store IP addresses. Use any long random string.
ANALYTICS_SALT=

# Google Sheets export — optional. A convenience mirror of completed checks;
# Supabase remains the source of truth. Leave blank to skip it entirely.
#
# Setup: Google Cloud Console → create/select a project → enable the
# "Google Sheets API" → IAM & Admin → Service Accounts → create one → Keys →
# Add key → JSON, then share your target sheet with that service account's
# email as an Editor. GOOGLE_SHEET_ID is the long id in the sheet's URL
# (…/spreadsheets/d/<THIS_PART>/edit). Add a header row to the sheet:
#   timestamp | currency | archetype | squeeze_day | cycle_days |
#   hypothesis_signal | wish | said_no | tool_gap | joined_waitlist | session_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1
