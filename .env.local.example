# Supabase — create a project at https://supabase.com, then run
#   supabase/migrations/0001_init.sql
# in the SQL editor.
#
# The browser never talks to Supabase directly. The service-role key is used
# only in server-side route handlers and must never be exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt for the one-way hashes used in rate limiting and device classification.
# We never store IP addresses. Use any long random string.
ANALYTICS_SALT=

# Google Sheets export — optional. A convenience mirror of completed checks;
# Supabase remains the source of truth. Leave blank to skip it entirely.
#
# Setup: see docs/sheets-webhook.gs for the Apps Script to paste into a sheet
# bound to your own Google account (Extensions → Apps Script), deployed as a
# web app. This avoids GCP service accounts entirely, since many Google Cloud
# orgs block service-account key creation by default
# (iam.managed.disableServiceAccountKeyCreation) and that isn't something a
# project owner can toggle without org-admin rights.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
